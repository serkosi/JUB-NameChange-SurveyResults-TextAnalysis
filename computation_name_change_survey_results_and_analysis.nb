Cell[BoxData[{
 RowBox[{
  RowBox[{"contentsOfAssociationsForIdeas", "=", 
   RowBox[{"TextContents", "[", 
    RowBox[{"ideasText", ",", 
     RowBox[{"VerifyInterpretation", "\[Rule]", "True"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"countsForIdeasAssociationsContentString", "=", 
    RowBox[{"ReverseSort", "@", 
     RowBox[{"CountsBy", "[", 
      RowBox[{"contentsOfAssociationsForIdeas", ",", 
       RowBox[{"#String", "&"}]}], "]"}]}]}], ",", 
   RowBox[{"countsForIdeasAssociationsContentType", "=", 
    RowBox[{"ReverseSort", "@", 
     RowBox[{"CountsBy", "[", 
      RowBox[{"contentsOfAssociationsForIdeas", ",", 
       RowBox[{"#Type", "&"}]}], "]"}]}]}], ",", 
   RowBox[{"countsForIdeasAssociationsContentInterpre", "=", 
    RowBox[{"ReverseSort", "@", 
     RowBox[{"CountsBy", "[", 
      RowBox[{"contentsOfAssociationsForIdeas", ",", 
       RowBox[{"#Interpretation", "&"}]}], "]"}]}]}]}], 
  "}"}], "\[IndentingNewLine]", 
 RowBox[{"entitylist", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"Keys", "@", "countsForIdeasAssociationsContentType"}], ")"}], 
     "[", 
     RowBox[{"[", "i", "]"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", 
      RowBox[{"Length", "@", "countsForIdeasAssociationsContentType"}]}], 
     "}"}]}], "]"}]}]}], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
