Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"1", " ", "\[Rule]", " ", "University"}], ",", " ", 
    RowBox[{"5", " ", "\[Rule]", " ", "Country"}], ",", " ", 
    RowBox[{"8", " ", "\[Rule]", " ", "City"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"x", "=", "8"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Strings for Ideas: \\n\>\"", ",", 
     RowBox[{"stringsOfAssociationsForIdeas", "=", 
      RowBox[{"Normal", "[", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{"contentsOfAssociationsForIdeas", ",", 
          RowBox[{
           RowBox[{"#Type", "===", 
            RowBox[{"entitylist", "[", 
             RowBox[{"[", "x", "]"}], "]"}]}], "&"}]}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "\"\<String\>\""}], "]"}], "]"}], "]"}]}]}], 
    "]"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Interpretations for Idea Strings: \\n\>\"", ",", 
     RowBox[{"interpretationsOfAssociationsForIdeas", "=", 
      RowBox[{"Normal", "[", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{"contentsOfAssociationsForIdeas", ",", 
          RowBox[{
           RowBox[{"#Type", "===", 
            RowBox[{"entitylist", "[", 
             RowBox[{"[", "x", "]"}], "]"}]}], "&"}]}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "\"\<Interpretation\>\""}], "]"}], "]"}], 
       "]"}]}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"resultArray", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"EntityValue", "[", 
        RowBox[{"interpretationsOfAssociationsForIdeas", ",", 
         RowBox[{
          RowBox[{"EntityProperties", "[", 
           RowBox[{"entitylist", "[", 
            RowBox[{"[", "x", "]"}], "]"}], "]"}], "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "@", 
          RowBox[{"EntityProperties", "[", 
           RowBox[{"entitylist", "[", 
            RowBox[{"[", "x", "]"}], "]"}], "]"}]}]}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"WordCloud", "@", 
    RowBox[{"Counts", "@", 
     RowBox[{"DeleteMissing", "@", 
      RowBox[{"Flatten", "@", "resultArray"}]}]}]}]}]}]], "Input",
